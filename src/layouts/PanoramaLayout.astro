---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Eliton</title>
    <meta name="description" content="Xem góc nhìn 360° của sản phẩm Eliton" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }
  
  html {
    font-family: var(--font-family);
    background: black;
  }
  
  body {
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: black;
    font-family: var(--font-family);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .a-enter-vr {
    position: fixed !important;
    bottom: 20px !important;
    right: 20px !important;
  }
</style>

<script>
  // Check WebGL support
  function checkWebGL() {
    try {
      const canvas = document.createElement('canvas');
      const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
      return !!gl;
    } catch (e) {
      return false;
    }
  }

  // Run checks when page loads
  window.addEventListener('load', () => {
    const hasWebGL = checkWebGL();
    if (!hasWebGL) {
      alert('Trình duyệt của bạn không hỗ trợ WebGL. Vui lòng sử dụng trình duyệt khác.');
    }
  });
</script> 